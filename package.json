{
  "name": "nemotron",
  "private": true,
  "workspaces": [
    "apps/*",
    "agents/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "eval": "bun scripts/evaluate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "latest"
  },
  "packageManager": "bun@1.4.4"
}
