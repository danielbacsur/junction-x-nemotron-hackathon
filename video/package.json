{
  "name": "lookout-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LookoutDemo out/render.mp4 && node scripts/master.mjs out/render.mp4 out/lookout-demo.mp4",
    "audio:vo": "node scripts/audio.mjs vo",
    "audio:music": "node scripts/audio.mjs music",
    "audio:sfx": "node scripts/audio.mjs sfx --force",
    "audio:sfx:local": "python3 scripts/sfx.py",
    "typecheck": "tsc --noEmit -p .",
    "audio:music:local": "python3 scripts/music.py && node scripts/audio.mjs levels",
    "audio:levels": "node scripts/audio.mjs levels"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
