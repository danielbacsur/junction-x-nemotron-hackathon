{
  "name": "lookout-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LookoutDemo out/lookout-demo.mp4",
    "audio:vo": "node scripts/audio.mjs vo",
    "audio:music": "node scripts/audio.mjs music",
    "audio:sfx": "node scripts/audio.mjs sfx --force",
    "audio:sfx:local": "python3 scripts/sfx.py",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
